<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- WifiLock 必需：缺此权限时 wifiLock.acquire() 会抛 SecurityException 直接崩进程 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 桌面歌词悬浮窗：在其他 App 之上显示歌词，需用户在设置里授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:label="@string/app_name" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".DownloadedActivity" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 全屏歌词页：从底部播放条的歌词按钮进入 -->
        <activity android:name=".LyricActivity" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".FavoritesActivity" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".SettingsActivity" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 净资产记账（移植自「净资产快照」WebView 工程）：不锁方向，横竖屏都用 -->
        <activity android:name=".NetAssetActivity" android:label="净资产记账" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <!-- 影视仓（TVBox / CatVod 风格视频模块）：不锁方向，视频可横屏，支持小窗(PiP)播放 -->
        <activity android:name=".VideoActivity" android:label="影视仓" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:supportsPictureInPicture="true"/>
        <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <receiver android:name=".PlayerBroadcastReceiver" android:exported="false"/>
    </application>
</manifest>
