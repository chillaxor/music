<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- 常驻悬浮按钮：非媒体播放类前台服务，targetSdk 34 需声明 specialUse 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- WifiLock 必需：缺此权限时 wifiLock.acquire() 会抛 SecurityException 直接崩进程 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 悬浮按钮长按展开气泡时的震动反馈（普通权限，安装即授予） -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- 桌面歌词悬浮窗：在其他 App 之上显示歌词，需用户在设置里授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- DLNA 投屏：SSDP 组播发现（MulticastLock）与 Wi-Fi 状态判断 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 提醒：精确闹钟（Android 12+ 需用户在设置里授权，未授权时 App 内自动降级非精确）+ 开机重排闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">
        <!-- 启动闪屏页：Launcher 唯一入口。进程起来前系统按主题 windowBackground
             画兜底色，本页再按用户配置显示自定义背景图，随后无动画切到 MainActivity -->
        <activity android:name=".SplashActivity" android:label="@string/app_name" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:label="@string/app_name" android:screenOrientation="portrait" android:exported="true"/>
        <activity android:name=".DownloadedActivity" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 全屏歌词页：从底部播放条的歌词按钮进入 -->
        <activity android:name=".LyricActivity" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".FavoritesActivity" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 正在播放列表页：从首页「🎵 正在播放列表」入口卡进入，看完整队列/切歌/移除 -->
        <activity android:name=".QueueActivity" android:label="正在播放列表" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 播放历史（影视仓）：断点续播，竖屏列表页 -->
        <activity android:name=".VideoHistoryActivity" android:label="播放历史" android:screenOrientation="portrait" android:exported="false"/>
        <activity android:name=".SettingsActivity" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 净资产记账（移植自「净资产快照」WebView 工程）：不锁方向，横竖屏都用 -->
        <activity android:name=".NetAssetActivity" android:label="净资产记账" android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"/>
        <!-- 影视仓（TVBox / CatVod 风格视频模块）：不锁方向，视频可横屏，支持小窗(PiP)播放 -->
        <activity android:name=".VideoActivity" android:label="影视仓" android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:supportsPictureInPicture="true"/>
        <!-- 高铁往返记录：独立 WebView 页面（仿净资产记账），数据走 SharedPreferences 落地 -->
        <activity android:name=".RailActivity" android:label="高铁往返" android:exported="false"
            android:screenOrientation="portrait"/>
        <!-- 提醒：生日/节日/高铁票，离线闹钟 + 状态栏通知 -->
        <activity android:name=".ReminderActivity" android:label="提醒" android:screenOrientation="portrait" android:exported="false"/>
        <!-- 提醒广播：闹钟到点弹通知；开机/时区变化/应用更新时全量重排闹钟 -->
        <receiver android:name=".ReminderReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
        <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <!-- 视频悬浮小窗：WindowManager 浮层 + 前台服务，可浮在任意页面/其他 App 之上 -->
        <service android:name=".VideoFloatService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <!-- 常驻悬浮按钮：WindowManager 浮层 + 前台服务保活，可浮在任意页面/其他 App 之上 -->
        <service android:name=".FloatButtonService" android:exported="false" android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_button"/>
        </service>
        <!-- 悬浮按钮配置页：透明底弹配置框，从设置页「配置悬浮按钮」进入（管理点击动作 + 长按气泡 + 图标） -->
        <activity
            android:name=".FloatConfigActivity"
            android:label="悬浮按钮动作"
            android:theme="@style/Theme.FloatConfig"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:exported="false"/>
        <receiver android:name=".PlayerBroadcastReceiver" android:exported="false"/>
    </application>
</manifest>
