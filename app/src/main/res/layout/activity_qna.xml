<?xml version="1.0" encoding="utf-8"?>
<!--
  问一句：端侧三段式检索 + 可切换的回答引擎（端侧 Qwen3 / 升级到云端）。
  - 输入问题或粘贴链接 → 搜索/抓取/整理 → 端侧或云端模型读材料作答
  - 右上角「云端设置」填写 endpoint / Key / 模型，即启用云端通道
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorPrimary"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            android:paddingEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="问一句"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"/>

        <TextView
            android:id="@+id/modelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 模型"
            android:textSize="13sp"
            android:textColor="?attr/colorOnPrimary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ 云端设置"
            android:textSize="13sp"
            android:textColor="?attr/colorOnPrimary"
            android:paddingStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 回答引擎选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="回答引擎"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <LinearLayout
                android:id="@+id/providerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="端侧三段式"
                    android:textSize="13sp"/>

                <Button
                    android:id="@+id/btnCloud"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="云端"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/providerState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="端侧：模型未加载"/>

            <!-- 问题输入 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="问一句"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <EditText
                android:id="@+id/questionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="8"
                android:textSize="14sp"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:hint="输入问题，或粘贴一个链接让我读（如 36kr 快讯）"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/askBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="问一句"
                    android:textSize="15sp"/>

                <Button
                    android:id="@+id/clearBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="清空"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/stageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:text=""/>

            <!-- 来源 -->
            <TextView
                android:id="@+id/sourcesLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="参考来源"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/sourcesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"/>

            <!-- 输出 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="回答"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"/>

            <TextView
                android:id="@+id/outputText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="120dp"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:text="（回答会显示在这里）"/>

            <Button
                android:id="@+id/copyBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="复制回答"
                android:textSize="14sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
