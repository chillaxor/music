<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 自定义启动背景图：全屏 centerCrop（没有图时 GONE，露出主题色兜底） -->
    <ImageView
        android:id="@+id/splashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="启动背景图" />

    <!-- 无自定义图：中央 logo + 应用名 + 主题色进度条 -->
    <LinearLayout
        android:id="@+id/splashCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="应用图标" />

        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- 有自定义图时：底部 App 名水印（半透明，不抢画面） -->
    <TextView
        android:id="@+id/splashCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:text="@string/app_name"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:visibility="gone"
        android:shadowColor="#80000000"
        android:shadowRadius="6"
        android:contentDescription="应用名" />
</FrameLayout>
