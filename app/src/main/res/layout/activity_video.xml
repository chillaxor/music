<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0e0f13">

    <!-- 影视仓 WebView 客户端（浏览 / 搜索 / 选集） -->
    <WebView
        android:id="@+id/videoWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 视频播放覆盖层：默认隐藏，点选集时拉起原生 ExoPlayer -->
    <FrameLayout
        android:id="@+id/videoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- 左上角：小窗按钮（默认隐藏，仅播放中且控制条可见时显示） -->
        <TextView
            android:id="@+id/videoPip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="小窗"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 全屏切换按钮：真正贴右下角（与底部 skipCfgRow 同一水平带、右端留 8dp）。
             底部配置行居中，右侧留白充足；时间/按钮行在 40~100dp，不会重叠。
             VideoActivity.positionSideBtns() 会按内嵌/全屏态覆写同样的 margin。 -->
        <ImageButton
            android:id="@+id/videoFull"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_pill_glass"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:src="@drawable/ic_fullscreen"
            android:tint="#FFFFFF"
            android:contentDescription="全屏切换"
            android:visibility="gone" />

        <!-- 顶部居中：视频标题（片名 · 线路 · 集名）。
             显隐逻辑与左上角小窗按钮一致：播放中 + 控制条可见才显示，
             控制条自动隐藏/暂停/进小窗/进系统PiP 时一并隐藏（见 updatePipButton）。
             maxWidth 300dp + ellipsize=end：防止长标题顶到左右两侧的按钮/时钟。 -->
        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#66000000"
            android:ellipsize="end"
            android:maxWidth="300dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text=""
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:visibility="gone"
            android:contentDescription="视频标题" />

        <!-- 右上角：当前时间（替代原集数标题/关闭按钮） -->
        <TextView
            android:id="@+id/videoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />

        <!-- 左侧中部：锁定播放界面（仅全屏态显示）。
             未锁时显示开锁图标，跟控制条一起显隐；点它锁住整个播放界面：
             控制条 / 顶部标题 / 时钟 / 右侧上下集 / 全屏键全隐藏，屏幕手势全部吞掉，
             只留本按钮常驻（图标变闭合锁）用于解锁。 -->
        <TextView
            android:id="@+id/videoLock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_glass"
            android:gravity="center"
            android:text="🔓"
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:visibility="gone"
            android:contentDescription="锁定播放界面" />

        <!-- 右侧中部：上一集 / 下一集。
             全屏态已把上下集搬到中间播放/暂停按钮左右，本竖排由 VideoActivity 隐藏，
             避免同屏两套；只有紧凑内嵌短条（控制条进 minimal、中间按钮组不可见）时才保留。
             内嵌态（详情页顶部短条）时由 VideoActivity 动态改成 bottom|end 下沉，
             避开顶部右侧的全屏切换按钮，避免误触；全屏态保持 center_vertical|end。 -->
        <LinearLayout
            android:id="@+id/videoSideBtns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/videoPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏮"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:contentDescription="上一集" />

            <TextView
                android:id="@+id/videoNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="10dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏭"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:contentDescription="下一集" />
        </LinearLayout>

        <!-- 横向拖动快进/后退时的居中提示：目标时间 + 快进/后退秒数（见 VideoActivity.setupSeekGesture） -->
        <TextView
            android:id="@+id/videoSeekHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#99000000"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:visibility="gone"
            android:contentDescription="快进后退提示" />

        <TextView
            android:id="@+id/videoBuffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="缓冲中…"
            android:textSize="15sp"
            android:textColor="#cccccc"
            android:visibility="gone" />

        <!-- 左侧上下滑动调亮度时显示的指示器 -->
        <TextView
            android:id="@+id/videoBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#99000000"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="☀ 100%"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 右侧上下滑动调音量时显示的指示器 -->
        <TextView
            android:id="@+id/videoVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#99000000"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="🔊 100%"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 长按屏幕（按住不动）3 倍速播放时显示的指示器：顶部标题下方一行，
             胶囊 pill 背景弱化存在感；避开与缓冲/亮度/音量指示器居中叠字 -->
        <TextView
            android:id="@+id/videoSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="52dp"
            android:background="@drawable/bg_speed_pill"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="3.0×"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 小窗模式：浮层（负责拖动 + 点击展开），默认隐藏 -->
        <FrameLayout
            android:id="@+id/videoMiniLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- 小窗上的「关闭」按钮：直接停播并关掉小窗（小窗不一定非要展开才能关） -->
            <TextView
                android:id="@+id/videoMiniClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="✕"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="关闭播放" />

            <!-- 小窗上的「展开回全屏」按钮（用户要的：关闭小屏→回全屏播放） -->
            <TextView
                android:id="@+id/videoMiniBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⤢"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="展开回全屏播放" />

            <!-- 小窗缩放：左下角 ＋/－（兜底保证能改尺寸；双指捏合在部分 ROM 收不到第二指时备用） -->
            <TextView
                android:id="@+id/videoMiniZoomIn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="＋"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:contentDescription="放大小窗" />

            <TextView
                android:id="@+id/videoMiniZoomOut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="－"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:contentDescription="缩小小窗" />
        </FrameLayout>

        <!-- DLNA 投屏遥控层：投屏中显示。本地播放器已停，手机变遥控器，
             画面在电视上，本层只做控制（播放/暂停/进度/切集/退出）。 -->
        <LinearLayout
            android:id="@+id/castLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0b0c10"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="📺 正在投屏"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/castExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#33ffffff"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="退出投屏"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:contentDescription="退出投屏回到本地播放" />
            </LinearLayout>

            <TextView
                android:id="@+id/castPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="28dp"
                android:background="#26ffffff"
                android:gravity="center"
                android:text="⏸"
                android:textSize="34sp"
                android:textColor="#ffffff"
                android:contentDescription="播放或暂停" />

            <TextView
                android:id="@+id/castHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="画面在电视上播放，手机可作遥控"
                android:textSize="13sp"
                android:textColor="#99ffffff" />

            <SeekBar
                android:id="@+id/castSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:progressTint="#ffffff"
                android:thumbTint="#ffffff" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castPos"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="#99ffffff" />

                <TextView
                    android:id="@+id/castDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="#99ffffff" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="#26ffffff"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="⏮ 上一集"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:contentDescription="上一集" />

                <TextView
                    android:id="@+id/castNext"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:background="#26ffffff"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="下一集 ⏭"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:contentDescription="下一集" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2026-11-13 用户要求：全屏播放时控制条「倍数」旁的「选集」按钮弹出的选集抽屉。
             做成 Activity 内的覆盖层而不是 AlertDialog / PopupWindow：全屏沉浸状态下
             独立窗口容易被系统栏、控制条自动显隐干扰；覆盖层还能自带滚动，几十上百集都放得下。
             默认 gone、clickable 吞掉下层触摸；左侧遮罩点一下关闭，右侧卡片里是剧集网格。
             与 videoMiniLayer / castLayer 同为 overlay 直属子层，放在最后保证在最上层，
             进小窗 / 投屏 / 锁定 / 关播时由 VideoActivity 主动收起。 -->
        <LinearLayout
            android:id="@+id/videoEpisodePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true">

            <View
                android:id="@+id/episodePanelMask"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/episodePanelCard"
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#F014151C"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/episodePanelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="选集"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/episodePanelClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="#33FFFFFF"
                        android:gravity="center"
                        android:text="✕"
                        android:textSize="16sp"
                        android:textColor="#FFFFFFFF"
                        android:contentDescription="关闭选集" />
                </LinearLayout>

                <TextView
                    android:id="@+id/episodePanelHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="点任意一集立即播放"
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF" />

                <GridView
                    android:id="@+id/episodeGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:numColumns="4"
                    android:horizontalSpacing="8dp"
                    android:verticalSpacing="8dp"
                    android:stretchMode="columnWidth"
                    android:gravity="center_horizontal"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
