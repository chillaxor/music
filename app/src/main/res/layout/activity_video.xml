<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0e0f13">

    <!-- 影视仓 WebView 客户端（浏览 / 搜索 / 选集） -->
    <WebView
        android:id="@+id/videoWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 视频播放覆盖层：默认隐藏，点选集时拉起原生 ExoPlayer -->
    <FrameLayout
        android:id="@+id/videoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- 左上角：小窗按钮（默认隐藏，仅播放中且控制条可见时显示） -->
        <TextView
            android:id="@+id/videoPip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🖼 小窗"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 右上角：当前时间（替代原集数标题/关闭按钮） -->
        <TextView
            android:id="@+id/videoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />

        <!-- 右侧中部：上一集 / 下一集 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/videoPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏮"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="上一集" />

            <TextView
                android:id="@+id/videoNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏭"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="下一集" />
        </LinearLayout>

        <TextView
            android:id="@+id/videoBuffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="缓冲中…"
            android:textSize="15sp"
            android:textColor="#cccccc"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
