<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0e0f13">

    <!-- 影视仓 WebView 客户端（浏览 / 搜索 / 选集） -->
    <WebView
        android:id="@+id/videoWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 视频播放覆盖层：默认隐藏，点选集时拉起原生 ExoPlayer -->
    <FrameLayout
        android:id="@+id/videoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <!-- 左上角：小窗按钮（默认隐藏，仅播放中且控制条可见时显示） -->
        <TextView
            android:id="@+id/videoPip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="🖼 小窗"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 顶部居中：视频标题（片名 · 线路 · 集名）。
             显隐逻辑与左上角小窗按钮一致：播放中 + 控制条可见才显示，
             控制条自动隐藏/暂停/进小窗/进系统PiP 时一并隐藏（见 updatePipButton）。
             maxWidth 300dp + ellipsize=end：防止长标题顶到左右两侧的按钮/时钟。 -->
        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#66000000"
            android:ellipsize="end"
            android:maxWidth="300dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text=""
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:visibility="gone"
            android:contentDescription="视频标题" />

        <!-- 右上角：当前时间（替代原集数标题/关闭按钮） -->
        <TextView
            android:id="@+id/videoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="#66000000"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff" />

        <!-- 右侧中部：上一集 / 下一集 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/videoPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏮"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="上一集" />

            <TextView
                android:id="@+id/videoNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⏭"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="下一集" />
        </LinearLayout>

        <!-- 横向拖动快进/后退时的居中提示：目标时间 + 快进/后退秒数（见 VideoActivity.setupSeekGesture） -->
        <TextView
            android:id="@+id/videoSeekHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#99000000"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:visibility="gone"
            android:contentDescription="快进后退提示" />

        <TextView
            android:id="@+id/videoBuffering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="缓冲中…"
            android:textSize="15sp"
            android:textColor="#cccccc"
            android:visibility="gone" />

        <!-- 左侧上下滑动调亮度时显示的指示器 -->
        <TextView
            android:id="@+id/videoBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#99000000"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="☀ 100%"
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <!-- 小窗模式：浮层（负责拖动 + 点击展开），默认隐藏 -->
        <FrameLayout
            android:id="@+id/videoMiniLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- 小窗上的「关闭」按钮：直接停播并关掉小窗（小窗不一定非要展开才能关） -->
            <TextView
                android:id="@+id/videoMiniClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="✕"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="关闭播放" />

            <!-- 小窗上的「展开回全屏」按钮（用户要的：关闭小屏→回全屏播放） -->
            <TextView
                android:id="@+id/videoMiniBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="⤢"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:contentDescription="展开回全屏播放" />

            <!-- 小窗缩放：左下角 ＋/－（兜底保证能改尺寸；双指捏合在部分 ROM 收不到第二指时备用） -->
            <TextView
                android:id="@+id/videoMiniZoomIn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="＋"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:contentDescription="放大小窗" />

            <TextView
                android:id="@+id/videoMiniZoomOut"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="48dp"
                android:layout_marginBottom="4dp"
                android:background="#66000000"
                android:gravity="center"
                android:text="－"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:contentDescription="缩小小窗" />
        </FrameLayout>

        <!-- DLNA 投屏遥控层：投屏中显示。本地播放器已停，手机变遥控器，
             画面在电视上，本层只做控制（播放/暂停/进度/切集/退出）。 -->
        <LinearLayout
            android:id="@+id/castLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0b0c10"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="📺 正在投屏"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/castExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#33ffffff"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="退出投屏"
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:contentDescription="退出投屏回到本地播放" />
            </LinearLayout>

            <TextView
                android:id="@+id/castPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="28dp"
                android:background="#26ffffff"
                android:gravity="center"
                android:text="⏸"
                android:textSize="34sp"
                android:textColor="#ffffff"
                android:contentDescription="播放或暂停" />

            <TextView
                android:id="@+id/castHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="画面在电视上播放，手机可作遥控"
                android:textSize="13sp"
                android:textColor="#99ffffff" />

            <SeekBar
                android:id="@+id/castSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:progressTint="#ffffff"
                android:thumbTint="#ffffff" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castPos"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="#99ffffff" />

                <TextView
                    android:id="@+id/castDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="12sp"
                    android:textColor="#99ffffff" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/castPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="#26ffffff"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="⏮ 上一集"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:contentDescription="上一集" />

                <TextView
                    android:id="@+id/castNext"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:background="#26ffffff"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="下一集 ⏭"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:contentDescription="下一集" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
