<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"
                android:textSize="16sp"
                android:textColor="@color/on_primary"
                android:paddingEnd="12dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📥 已下载"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"/>
            <!-- 原「清空全部」已移除：它会连手机文件夹里的歌曲原文件一起删掉 -->
        </LinearLayout>
        <TextView
            android:id="@+id/totalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/on_primary"
            android:alpha="0.85"
            android:paddingTop="3dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playAllBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="▶ 播放全部"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/importBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📁 导入文件夹"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 搜索：本地曲库大了之后靠翻找不现实，按歌名/歌手/专辑过滤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp">
        <EditText
            android:id="@+id/dlSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_round"
            android:hint="🔍 搜索歌曲 / 歌手 / 专辑"
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"/>
        <TextView
            android:id="@+id/dlSearchClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingStart="12dp"
            android:paddingEnd="2dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- 文件夹 Tab：切换只播/只看某个文件夹；「播放全部」灌的是当前 Tab 的歌 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">
        <LinearLayout
            android:id="@+id/folderTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- 列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloadedList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="还没有下载的歌曲\n在搜索结果里点 ⬇ 离线保存，或点「📁 导入文件夹」把手机里已有的音乐加进来"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"/>
</LinearLayout>
