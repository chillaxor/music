<?xml version="1.0" encoding="utf-8"?>
<!--
  正在播放列表页（从首页「🎵 正在播放列表」入口卡进入）：
  - 顶部主题色标题栏：返回 / 标题 / 播放全部 / 清空 + 计数行（与收藏页/下载页同款头栏）
  - 列表复用 item_queue_song（白卡行，主题属性文字色）：行点击=切到该首播放，
    右侧 ✕=从队列移除，当前播放项主题色高亮 + 「▶ 播放中」徽章
  - 空状态：提示去搜索（按钮跳回首页并切到搜索页签，MainActivity 读 open_tab）
  数据全部来自全局 PlayerManager，与首页播放条/歌词页/桌面歌词同一份队列。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部标题栏：主题色底（ThemePrefs.applyTheme 生效） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"
                android:textSize="16sp"
                android:textColor="@color/on_primary"
                android:paddingEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎵 正在播放列表"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/playAllQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ 播放全部"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

            <TextView
                android:id="@+id/clearQueue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                android:textSize="14sp"
                android:textColor="@color/on_primary"
                android:alpha="0.85"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

        <!-- 计数行：共 N 首 / 临时播放中提示 -->
        <TextView
            android:id="@+id/queueCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/on_primary"
            android:alpha="0.85"
            android:paddingTop="4dp"
            android:includeFontPadding="false"/>
    </LinearLayout>

    <!-- 列表区：占满剩余高度 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"/>

        <!-- 空列表提示 -->
        <LinearLayout
            android:id="@+id/queueEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="48sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="播放列表还是空的"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:paddingTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去搜索喜欢的歌，点一下就播"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingTop="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gotoSearchBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="去搜索"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 底部播放条：与首页播放条同款控制（上一首/播放暂停/下一首/播放模式/桌面歌词）。
         点控制按钮各自生效；点按钮以外的区域（含歌名/歌手）整条进歌词页（LyricActivity）。
         无正在播放的歌时整体隐藏（代码控制显隐）。
         播放键圆圈底色由 QueueActivity 按当前主题重画（drawable 无法用 ?attr 上色） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/queuePlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/qPrevBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev"
                android:tint="?attr/colorOnSurface"
                android:scaleType="centerInside"
                android:contentDescription="上一首"/>

            <ImageButton
                android:id="@+id/qPlayPauseBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_circle_primary"
                android:src="@drawable/ic_play"
                android:tint="@color/on_primary"
                android:scaleType="centerInside"
                android:contentDescription="播放/暂停"/>

            <ImageButton
                android:id="@+id/qNextBtn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="?attr/colorOnSurface"
                android:scaleType="centerInside"
                android:contentDescription="下一首"/>

            <!-- 歌曲名 + 歌手（weight=1 吃掉中部空间，把右侧模式按钮顶到边） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/qNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未播放"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/qNowArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:paddingTop="1dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/qModeBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sequence"
                android:tint="?attr/colorOnSurface"
                android:scaleType="centerInside"
                android:contentDescription="播放模式"/>

            <!-- 悬浮（桌面歌词）开关：与首页原播放条的桌面歌词按钮同款；开/关后颜色随状态变。
                 注意：本按钮有独立点击监听，不会冒泡到整条播放条的「点空白进歌词页」 -->
            <ImageButton
                android:id="@+id/qLyricFloatBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_lyric_float"
                android:tint="?attr/colorOnSurface"
                android:scaleType="centerInside"
                android:contentDescription="桌面歌词"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
