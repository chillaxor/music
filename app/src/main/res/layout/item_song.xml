<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索结果卡 / 队列卡 / 下载卡共用的歌曲行。
  2026-11-06 A+D 配色：底色从暖棕 #B31C1A18 换成同色相冷灰 #B3161B21
  （保持 70% 不透明 —— 列表在滚动，比首页玻璃卡需要更实的底），
  文字与操作图标从暖白/暖灰/橙色统一为冷白 + 主题色，跟首页玻璃卡同一套色系。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#B3161B21"
    app:strokeColor="#33FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/songName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F2F3F5"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/songArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#AEB7C2"
                android:paddingTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/songSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="5dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/insertBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="20sp"
            android:text="⏫"
            android:textColor="?attr/colorPrimary"
            android:contentDescription="插入播放列表最前面并播放"/>

        <TextView
            android:id="@+id/dlBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="22sp"
            android:text="⬇"
            android:textColor="#AEB7C2"/>

        <TextView
            android:id="@+id/favBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textSize="24sp"
            android:text="☆"
            android:textColor="#AEB7C2"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
