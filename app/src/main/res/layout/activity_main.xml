<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 = 全屏沉浸图版式（方案 D）：
  底层：主题渐变兜底 → 每日一图（用户文件夹按日轮换）→ 深色蒙层（保证白字可读）
  上层：精简顶行 + 玻璃页签 + 播放列表面板（问候行/工具卡/正在播放卡/播放列表卡）
  说明：
  - 没有配每日一图时 dailyImage 隐藏，露出主题渐变兜底底色，页面照常可用
  - 所有浮在图上的文字统一用白/透白色，不再吃主题的 colorOnSurface（深色字会在图上糊）
  - 播放列表/搜索两个面板、队列适配器等 id 全部保持原名，Kotlin 侧绑定不变
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 兜底底色：无每日一图时显示。applyThemeColors() 会按主题色重画 -->
    <View
        android:id="@+id/themeFallbackBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"/>

    <!-- 每日一图：用户文件夹按日轮换，centerCrop 铺满 -->
    <ImageView
        android:id="@+id/dailyImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="每日一图"/>

    <!-- 蒙层：两端渐变压暗保证白字可读，中部完全透明让图通透（不再是整屏 65% 黑） -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dim_gradient"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶行：logo + 主题 + 设置（收藏/下载已收进下方工具卡） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="彬💖冰 颢👣涵"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:includeFontPadding="false"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/themeBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_theme"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:contentDescription="切换主题"/>

            <ImageButton
                android:id="@+id/openSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:contentDescription="设置"/>
        </LinearLayout>

        <!-- 玻璃页签：选中=白底主题字，未选=半透明白底白字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tabPlaylist"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="播放列表"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_white"
                android:textColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tabSearch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔍 搜索歌曲"
                android:textSize="14sp"
                android:background="@drawable/bg_pill_glass"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ========== 播放列表面板（默认进入） ========== -->
            <LinearLayout
                android:id="@+id/playlistPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp">

                <!-- 问候行：时段问候 + 日期 + 图序号；点一下=手动换图，长按=换文件夹 -->
                <LinearLayout
                    android:id="@+id/greetingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="你好"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每日一图"
                        android:textSize="12sp"
                        android:paddingTop="2dp"
                        android:textColor="#D9FFFFFF"
                        android:includeFontPadding="false"/>
                </LinearLayout>

                <!-- 金价 / 高铁信息条：融入背景的小字行，接口失败或无记录则隐藏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/goldBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/goldDom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="13dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:background="#FFFFFF"
                            android:alpha="0.45"/>

                        <TextView
                            android:id="@+id/goldIntl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/railBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/railHome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 工具玻璃卡：固定入口 + 自定义资源位统一网格（一行 5 个，见 renderShortcuts） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <!-- 固定入口（记账/看片/收藏/下载）+ 自定义资源位 + 「＋」，超长自动换行 -->
                    <com.linghit.gdmusic.FlowLayout
                        android:id="@+id/shortcutRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <!-- 播放列表玻璃卡：标题行 + 列表（占满剩余高度） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/queueCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#B31C1A18"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/queueCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="播放列表"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/playAllQueue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▶ 播放全部"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>

                            <TextView
                                android:id="@+id/clearQueue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="清空"
                                android:textSize="13sp"
                                android:textColor="#B8FFFFFF"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"/>
                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/queueList"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:paddingBottom="8dp"/>

                            <!-- 空列表提示 -->
                            <LinearLayout
                                android:id="@+id/queueEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:visibility="gone">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🎶"
                                    android:textSize="48sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="播放列表还是空的"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF"
                                    android:paddingTop="10dp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="去搜索喜欢的歌，点一下就播"
                                    android:textSize="13sp"
                                    android:textColor="#B8FFFFFF"
                                    android:paddingTop="6dp"/>
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/gotoSearchBtn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:text="去搜索"/>
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 正在播放玻璃卡：常驻页面底部，有歌才显示（代码控制显隐）；
                     封面用默认音符图，不接在线封面回调 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#B31C1A18"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <!-- 最左：上一首 / 播放暂停 / 下一首 -->
                        <ImageButton
                            android:id="@+id/prevBtn"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_prev"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="上一首"/>

                        <ImageButton
                            android:id="@+id/playPauseBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_circle_primary"
                            android:src="@drawable/ic_play"
                            android:tint="@color/on_primary"
                            android:scaleType="centerInside"/>

                        <ImageButton
                            android:id="@+id/nextBtn"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_next"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="下一首"/>

                        <!-- 按钮之后：歌曲名 + 歌手（weight=1 吃掉中部空间，把右侧按钮顶到边） -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/nowPlaying"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="未播放"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/nowArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="11sp"
                                android:paddingTop="1dp"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/lyricFloatBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_lyric_float"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="桌面歌词"/>

                        <ImageButton
                            android:id="@+id/lyricPageBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_lyric_page"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="歌词页"/>

                        <ImageButton
                            android:id="@+id/modeBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_sequence"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="播放模式"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========== 搜索面板 ========== -->
            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <!-- 搜索卡片（玻璃） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/searchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#B31C1A18"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="搜索歌曲 / 歌手">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/searchInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:imeOptions="actionSearch"
                                android:maxLines="1"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#99FFFFFF"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchButton"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:text="搜索"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="搜索后点击歌曲即可播放"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    android:padding="4dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/songList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
