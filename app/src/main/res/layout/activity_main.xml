<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 = 全屏沉浸图版式（信息卡版）：
  底层：主题渐变兜底 → 每日一图（用户文件夹按日轮换）→ 深色蒙层（保证白字可读）
  上层：精简顶行 + 玻璃页签 + 主面板（问候行/双列信息卡/工具卡/底部播放条）
  信息卡两排（左右双列，图标统一 🎵）：
  - 第一排：黄金金价（左，国内外双价）+ 高铁日程（右，点进高铁往返页）
  - 第二排：今日消费（左，点进记账页）+ 新闻热榜（右，点进 NewsActivity）
  说明：
  - 没有配每日一图时 dailyImage 隐藏，露出主题渐变兜底底色，页面照常可用
  - 所有浮在图上的文字统一用白/透白色，不再吃主题的 colorOnSurface（深色字会在图上糊）
  - 完整播放队列已拆到独立页 QueueActivity：首页无播放卡，只在底部播放条放
    「🎵 N」队列 pill 作入口——自定义资源位再多也挤不到播放区
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 兜底底色：无每日一图时显示。applyThemeColors() 会按主题色重画 -->
    <View
        android:id="@+id/themeFallbackBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"/>

    <!-- 每日一图：用户文件夹按日轮换，centerCrop 铺满 -->
    <ImageView
        android:id="@+id/dailyImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="每日一图"/>

    <!-- 蒙层：两端渐变压暗保证白字可读，中部完全透明让图通透（不再是整屏 65% 黑） -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dim_gradient"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶行：logo + 主题 + 设置（收藏/下载已收进下方工具卡） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="彬💖冰 颢👣涵"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:includeFontPadding="false"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/themeBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_theme"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:contentDescription="切换主题"/>

            <ImageButton
                android:id="@+id/openSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF"
                android:scaleType="centerInside"
                android:contentDescription="设置"/>
        </LinearLayout>

        <!-- 玻璃页签：选中=白底主题字，未选=半透明白底白字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tabPlaylist"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="首页"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_white"
                android:textColor="?attr/colorPrimary"/>

            <TextView
                android:id="@+id/tabSearch"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🔍 搜索歌曲"
                android:textSize="14sp"
                android:background="@drawable/bg_pill_glass"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ========== 播放列表面板（默认进入） ========== -->
            <LinearLayout
                android:id="@+id/playlistPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp">

                <!-- 问候行：时段问候 + 日期 + 图序号；点一下=手动换图，长按=换文件夹 -->
                <LinearLayout
                    android:id="@+id/greetingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="你好"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="每日一图"
                        android:textSize="12sp"
                        android:paddingTop="2dp"
                        android:textColor="#D9FFFFFF"
                        android:includeFontPadding="false"/>
                </LinearLayout>

                <!-- ========== 第一排信息卡：黄金金价 + 高铁日程（左右双列，图标统一 🎵） ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- 黄金金价卡：国内外双价，接口失败显示空值；点击手动刷新 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/goldCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#B31C1A18"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🎵 黄金金价"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:id="@+id/goldDomVal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="国内 --"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingTop="3dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:id="@+id/goldIntlVal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="国际 --"
                                android:textSize="11sp"
                                android:textColor="#B8FFFFFF"
                                android:paddingTop="2dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 高铁日程卡：距上次离家 N 天 / 正在家 / 下次计划；点击进高铁往返页 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/railCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#B31C1A18"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🎵 高铁日程"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:id="@+id/railCardVal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="暂无行程"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingTop="3dp"
                                android:maxLines="2"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ========== 第二排信息卡：今日消费 + 新闻热榜（左右双列，图标统一 🎵） ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <!-- 今日消费卡：读记账页 flows（type=支出）按今天求和；点击进记账页 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/spendCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#B31C1A18"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🎵 今日消费"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:id="@+id/spendVal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¥0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingTop="3dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:id="@+id/spendCnt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="今天还没记账"
                                android:textSize="11sp"
                                android:textColor="#B8FFFFFF"
                                android:paddingTop="2dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 新闻热榜卡：今日头条热榜入口；点击进 NewsActivity -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/newsCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#B31C1A18"
                        app:strokeColor="#33FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🎵 新闻热榜"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="今日热点 ›"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:paddingTop="3dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="头条热榜实时更新"
                                android:textSize="11sp"
                                android:textColor="#B8FFFFFF"
                                android:paddingTop="2dp"
                                android:maxLines="1"
                                android:includeFontPadding="false"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 工具玻璃卡：固定入口 + 自定义资源位统一网格（一行 6 个，首末贴卡片缘，见 renderShortcuts） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginBottom="10dp">

                    <!-- 固定入口（记账/看片/收藏/下载）+ 自定义资源位 + 「＋」，超长自动换行 -->
                    <com.linghit.gdmusic.FlowLayout
                        android:id="@+id/shortcutRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"/>
                </LinearLayout>

                <!-- 播放卡已整体移除：完整队列入口改到底部播放条的「🎵 N」pill
                     （见 playerBar 内 queuePill）——自定义资源位再多也挤不到播放区 -->

                <!-- 弹性占位：把底部播放条继续钉在屏幕底。
                     原「播放列表卡」靠 layout_weight=1 占满剩余高度顺带实现了这个效果，
                     队列拆去 QueueActivity 后这里补一个纯 View，布局语义不变 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- 正在播放玻璃卡：常驻页面底部，有歌才显示（代码控制显隐）；
                     封面用默认音符图，不接在线封面回调 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/playerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#B31C1A18"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">

                        <!-- 最左：上一首 / 播放暂停 / 下一首 -->
                        <ImageButton
                            android:id="@+id/prevBtn"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_prev"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="上一首"/>

                        <ImageButton
                            android:id="@+id/playPauseBtn"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="2dp"
                            android:background="@drawable/bg_circle_primary"
                            android:src="@drawable/ic_play"
                            android:tint="@color/on_primary"
                            android:scaleType="centerInside"/>

                        <ImageButton
                            android:id="@+id/nextBtn"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_next"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="下一首"/>

                        <!-- 按钮之后：歌曲名 + 歌手（weight=1 吃掉中部空间，把右侧按钮顶到边） -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp">

                            <TextView
                                android:id="@+id/nowPlaying"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="未播放"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:maxLines="1"
                                android:ellipsize="end"/>

                            <TextView
                                android:id="@+id/nowArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="11sp"
                                android:paddingTop="1dp"
                                android:textColor="#B8FFFFFF"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <!-- 队列 pill：「🎵 N」= 当前播放列表歌曲数（MainActivity.refreshQueueEntry 维护），
                             点击进 QueueActivity 看完整队列/切歌/移除 -->
                        <TextView
                            android:id="@+id/queuePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎵 0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_pill_glass"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:includeFontPadding="false"/>

                        <ImageButton
                            android:id="@+id/lyricFloatBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_lyric_float"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="桌面歌词"/>

                        <ImageButton
                            android:id="@+id/lyricPageBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_lyric_page"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="歌词页"/>

                        <ImageButton
                            android:id="@+id/modeBtn"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="2dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_sequence"
                            android:tint="#FFFFFF"
                            android:scaleType="centerInside"
                            android:contentDescription="播放模式"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========== 搜索面板 ========== -->
            <LinearLayout
                android:id="@+id/searchPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <!-- 搜索卡片（玻璃） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/searchCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#B31C1A18"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="10dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="搜索歌曲 / 歌手">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/searchInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:imeOptions="actionSearch"
                                android:maxLines="1"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#99FFFFFF"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/searchButton"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:text="搜索"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="搜索后点击歌曲即可播放"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    android:padding="4dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/songList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="4dp"
                    android:paddingBottom="8dp"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
