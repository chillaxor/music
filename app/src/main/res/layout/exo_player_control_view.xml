<?xml version="1.0" encoding="utf-8"?>
<!--
  media3 播放器控制条布局覆写（默认见 media3-ui 的 exo_player_control_view.xml）：
  原布局整体照抄，底部加一行「片头 / 片尾 / 投屏 / 倍数」配置按钮（skipCfgRow），
  并把时间行（当前时间 / 视频总时长）从 exo_bottom_bar 里提出来，单独贴在进度条上沿。

  ⚠️ 2026-11-09 用户要求：播放视频时进度条要在「设置开始时间 / 设置结束时间 /
     设置速率」这一行（skipCfgRow）的上边，并且要看得见该视频的总时长。
     从屏幕底部往上依次是：
       配置行 4~38dp → 进度条占位 42~90dp → 时间行 92~120dp（左侧）
       右侧按钮行仍 90~150dp（与时间行左右分离，不重叠）
     进度条位置由 dimens 的 exo_styled_progress_margin_bottom=42dp 决定
     （PlayerControlViewLayoutManager 会按这个 dimen 重置 bottomMargin，改 XML margin 无效）。
     42/90/92 这组值是 11-05「进度条下移贴配置行」的定案，本次不移动进度条，
     只把总时长从远处（原 exo_bottom_bar 内、70% 灰白、minimal 模式随整条隐藏）
     提到进度条正上方并改成纯白加粗，保证稳定可见。
     media3 PlayerControlView 只按 id 给 exo_position / exo_duration setText，
     不会改父容器可见性，所以把 exo_time 移到 merge 顶层是安全的。
  ⚠️ exo_bottom_bar 原带 media3 默认 #b0000000（70% 黑）背景，叠加全屏
     exo_controls_background 的 60% 遮罩后，进度条下方会出现一条明显更黑的通栏。
     按要求改为透明，文字可读性仍由全屏遮罩保证。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 0dp dimensions are used to prevent this view from influencing the size of
       the parent view if it uses "wrap_content". It is expanded to occupy the
       entirety of the parent in code, after the parent's size has been
       determined. See: https://github.com/google/ExoPlayer/issues/8726.
  -->
  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/exo_black_opacity_60"/>

  <FrameLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_bottom_bar_height"
      android:layout_marginTop="@dimen/exo_styled_bottom_bar_margin_top"
      android:layout_gravity="bottom"
      android:layout_marginBottom="90dp"
      android:background="@android:color/transparent"
      android:layoutDirection="ltr">

    <!-- 时间行 exo_time 已移到 merge 顶层，贴在进度条上沿显示 当前时间 / 总时长。
         这里只保留右侧的设置/全屏等按钮，避免与时间行抢左侧空间。 -->

    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_vr"
          style="@style/ExoStyledControls.Button.Bottom.VR"/>

      <ImageButton android:id="@id/exo_shuffle"
          style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

      <ImageButton android:id="@id/exo_subtitle"
          style="@style/ExoStyledControls.Button.Bottom.CC"/>

      <ImageButton android:id="@id/exo_settings"
          style="@style/ExoStyledControls.Button.Bottom.Settings"/>

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

    </LinearLayout>

    <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:visibility="invisible">

      <LinearLayout android:id="@id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layoutDirection="ltr">

        <ImageButton android:id="@id/exo_overflow_hide"
            style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

      </LinearLayout>

    </HorizontalScrollView>

  </FrameLayout>

  <View android:id="@id/exo_progress_placeholder"
      android:layout_width="match_parent"
      android:layout_height="@dimen/exo_styled_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginBottom="@dimen/exo_styled_progress_margin_bottom"/>

  <!-- 时间行：紧贴进度条上沿（进度条占位 42~90dp，本行 marginBottom=92dp），左侧。
       格式「当前时间 / 视频总时长」；总时长纯白加粗放大，一眼能看到这片子多长。
       ID 沿用 exo_position / exo_duration，media3 PlayerControlView 每次进度刷新时
       会照常 setText，不需要在 Kotlin 里重复维护一份计时逻辑。
       独立放在 merge 顶层后，即使 minimal 模式把 exo_bottom_bar 整条隐藏，时长仍在。 -->
  <LinearLayout android:id="@id/exo_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/exo_styled_bottom_bar_time_padding"
      android:paddingEnd="@dimen/exo_styled_bottom_bar_time_padding"
      android:paddingLeft="@dimen/exo_styled_bottom_bar_time_padding"
      android:paddingRight="@dimen/exo_styled_bottom_bar_time_padding"
      android:layout_gravity="bottom|start"
      android:layout_marginBottom="92dp"
      android:layoutDirection="ltr">

    <TextView android:id="@id/exo_position"
        style="@style/ExoStyledControls.TimeText.Position"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />

    <TextView
        style="@style/ExoStyledControls.TimeText.Separator"
        android:text="/"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp" />

    <TextView android:id="@id/exo_duration"
        style="@style/ExoStyledControls.TimeText.Duration"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:contentDescription="视频总时长" />

  </LinearLayout>

  <!-- 片头 / 片尾跳过配置：贴在画面最底部（marginBottom=4dp），进度条紧贴在它上方。
       配置按影片详情维度保存，对本影片所有剧集/线路生效，其他影片不受影响。
       联动：exo_bottom_bar 上移到 90dp、exo_minimal_controls 上移到 92dp，
       给下移后的进度条让位；activity_video.xml 的全屏键与 positionSideBtns()
       贴右下角 4dp/8dp（配置行居中，右侧留白够，不与时间/按钮行重叠）。 -->
  <!-- 2026-11-13：加了第 5 个「选集」chip 后，窄屏（详情页内嵌竖条）一行摆不下 5 个，
       外面套一层可横向滚动的容器。宽屏（全屏横屏）下 fillViewport + gravity=center
       仍是居中一排，与原来完全一致；窄屏则能滑到最右侧的「选集」。
       ⚠️ id 仍叫 skipCfgRow 且仍是那一排 chip 的 LinearLayout：setupPlayGestures()
       用它的 getLocationOnScreen / width 判断「手势不接管区域」，结构变化不影响。 -->
  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:layout_marginBottom="4dp"
      android:fillViewport="true"
      android:scrollbars="none"
      android:overScrollMode="never">

  <LinearLayout
      android:id="@+id/skipCfgRow"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:orientation="horizontal"
      android:gravity="center"
      android:paddingStart="12dp"
      android:paddingEnd="12dp">

    <TextView
        android:id="@+id/skipStartBtn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="#40000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="片头 未设置"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="设置开始播放时间" />

    <TextView
        android:id="@+id/skipEndBtn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="#40000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="片尾 未设置"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="设置结束播放时间" />

    <!-- DLNA 投屏入口：点后组播搜索局域网渲染器（电视/盒子） -->
    <TextView
        android:id="@+id/castBtn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="#40000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="投屏"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="投屏到电视" />

    <!-- 播放倍数：常驻可见的第 4 个 chip，按钮上显示当前档位。点它就地弹出选档菜单
         （PopupMenu 锚定本按钮，不遮挡整幅画面）；原先只有「长按屏幕临时 3×」的隐藏手势，
         长按松手后回到本菜单所选档位。 -->
    <TextView
        android:id="@+id/speedBtn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="#40000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="倍数 1.0×"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="播放倍数" />

    <!-- 2026-11-13 用户要求：全屏播放时在「倍数」旁边加「选集」。
         点它弹出右侧抽屉列出当前线路全部剧集，点任意一集立即播放（复用 playIndex，
         直链 / 播放页嗅探 / 爬虫源解析三条分支都照旧走）。
         VideoActivity.showEpisodePanel() 负责填充 GridView，当前集高亮。 -->
    <TextView
        android:id="@+id/episodesBtn"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="10dp"
        android:background="#40000000"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="选集"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"
        android:contentDescription="打开选集列表" />
  </LinearLayout>
  </HorizontalScrollView>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="92dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!-- 2026-11-13 用户要求：上一集 / 下一集 紧挨中间「播放 / 暂停」按钮的左右。
       原布局是 media3 默认的按钮组 上一个 / 快退 / 播放暂停 / 快进 / 下一个，
       其中 exo_prev / exo_next 是「上一个/下一个媒体项」，跟影视仓的「上一集」不是一回事，
       用户真正要的切集按钮却在右侧中部竖排、离播放键很远。这里精简成三个：
           [⏮ 上一集] [▶/⏸ 播放暂停] [⏭ 下一集]
       用自定义 id（videoCenterPrev / videoCenterNext）而不用 exo_prev / exo_next：
       media3 PlayerControlView 会按 id 给后者绑 seekToPrevious/Next，并在 updateNavigation()
       里按 player 的 COMMAND 可用性改 enabled/visibility，单片播放时会被禁用；
       自定义 id 它完全不管，切集逻辑由 VideoActivity 绑 playPrev()/playNext()，走 epsList。
       快退/快进按钮（exo_rew / exo_ffwd）一并去掉：进度条拖动 + 左右滑动手势仍可快进，
       留着反而与「上一集/下一集」图标混淆。PlayerControlView 对这些 id 都判空，删掉安全。 -->
  <LinearLayout
      android:id="@id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:padding="@dimen/exo_styled_controls_padding"
      android:clipToPadding="false"
      android:layoutDirection="ltr">

    <ImageButton android:id="@+id/videoCenterPrev"
        style="@style/ExoStyledControls.Button.Center.Previous"
        android:contentDescription="上一集" />

    <ImageButton android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"/>

    <ImageButton android:id="@+id/videoCenterNext"
        style="@style/ExoStyledControls.Button.Center.Next"
        android:contentDescription="下一集" />

  </LinearLayout>

</merge>
