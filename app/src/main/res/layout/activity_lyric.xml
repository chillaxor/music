<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 顶部：返回 + 歌名/歌手 + 重试（无歌词时才可见） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">
        <ImageButton
            android:id="@+id/lyricBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/on_surface"
            android:scaleType="centerInside"
            android:contentDescription="返回"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">
            <TextView
                android:id="@+id/lyricTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未播放"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/lyricArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:paddingTop="2dp"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
        <TextView
            android:id="@+id/lyricRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重试"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- LRC 歌词行 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lyricList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"/>

        <!-- 纯文本歌词（无时间戳）：整段展示 -->
        <ScrollView
            android:id="@+id/lyricPlainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/lyricPlain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/on_surface_variant"
                android:lineSpacingMultiplier="1.4"/>
        </ScrollView>

        <!-- 无歌词空态 -->
        <LinearLayout
            android:id="@+id/lyricEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♪"
                android:textSize="44sp"
                android:textColor="@color/primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无歌词"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:paddingTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="联网后点右上「重试」即可获取&#10;下载歌曲时歌词会自动一并保存"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:paddingTop="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- 播放控制：进度条 + 音量 + 上一首/播放/下一首 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp">

        <!-- 播放进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/lyricCurTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant"
                android:minWidth="36dp"/>
            <SeekBar
                android:id="@+id/lyricProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"/>
            <TextView
                android:id="@+id/lyricTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="end"
                android:minWidth="36dp"/>
        </LinearLayout>

        <!-- 音量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="13sp"/>
            <SeekBar
                android:id="@+id/lyricVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:max="100"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"/>
            <TextView
                android:id="@+id/lyricVolumeText"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100"
                android:textSize="11sp"
                android:textColor="@color/on_surface_variant"/>
        </LinearLayout>

        <!-- 上一首 / 播放 / 下一首 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp">
            <ImageButton
                android:id="@+id/lyricPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev"
                android:tint="@color/on_surface"
                android:scaleType="centerInside"
                android:contentDescription="上一首"/>
            <ImageButton
                android:id="@+id/lyricPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_circle_primary"
                android:src="@drawable/ic_play"
                android:tint="@color/on_primary"
                android:scaleType="centerInside"/>
            <ImageButton
                android:id="@+id/lyricNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:tint="@color/on_surface"
                android:scaleType="centerInside"
                android:contentDescription="下一首"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
