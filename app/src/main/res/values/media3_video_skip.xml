<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      media3-ui 的 dimens 覆写（app 资源优先于库资源，只影响播放器控制条布局）：
      原值 52dp 只够放下「进度条 + 底部时间/按钮行」。
      改成 108dp 把进度条整体顶上去，给 exo_player_control_view.xml 里新增的
      「片头/片尾跳过」配置行（marginBottom=60dp，高约 34dp）腾出位置。
      PlayerControlViewLayoutManager 每次尺寸变化都会按这个 dimen 重置进度条
      的 bottomMargin，所以必须在资源层改，改 XML 里的 margin 会被覆盖。
    -->
    <dimen name="exo_styled_progress_margin_bottom">108dp</dimen>
</resources>
